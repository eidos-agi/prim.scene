      "type": "decision",
      "title": "North star is reusable scene video, not reprint math and not a jargon trailer",
      "status": "active",
      "description": "Keep the shot. Score the public face against that. Do not lead with 160,000× Imagine cheapness.",
      "rationale": {
        "why": "AI clips cannot steer or recreate. Eidos Video's only durable advantage is the scene file.",
        "problems": ["opf:eidos-video:problem:one-shot-generate"],
        "alternatives": [
          {
            "option": "Market as cheaper than Imagine (160,000× / $0.0005)",
            "disposition": "ruled-out",
            "reason": "That is a bill comparison. The product is flexibility."
          },
          {
            "option": "Figure-shaped film with no recipe",
            "disposition": "partial",
            "reason": "Film-first is right for viewers. Makers still need write-capture-recapture."
          }
        ],
        "revisit_when": ["A cold maker completes recapture from the public page.", "A second renderer generation is shown on the same scene."]
      },
      "provenance": {"by": "human:daniel", "method": "Asked to set the OPF north star about what it is really about"}
    },
